# Database
DATABASE_URL=<set-in-your-.env>
REDIS_URL=<set-in-your-.env>

# ClickUp (get token from ClickUp → Settings → Apps → API Token)
# ClickUp
CLICKUP_API_TOKEN=<set-in-your-.env>
CLICKUP_WORKSPACE_ID=<set-in-your-.env>
CLICKUP_LIST_ID=<set-in-your-.env>

# LLM API Keys (OpenRouter is the default provider)
OPENROUTER_API_KEY=<set-in-your-.env>
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_REQUEST_TIMEOUT=120
# Optional: max seconds per initiative task (default 600)
INITIATIVE_TASK_TIMEOUT_SECONDS=600

# Optional: CORS for dashboard dev. Defaults allow localhost Vite ports.
# Set to __DISABLED__ to turn off CORS middleware (same-origin dashboard only).
# CORS_ORIGINS=__DISABLED__

# Chroma (leave unset for local persist in ./chroma_data)
# CHROMA_HOST=localhost
# CHROMA_PORT=8001

# Facebook/Meta Ads API
FACEBOOK_ACCESS_TOKEN=<set-in-your-.env>
FACEBOOK_AD_ACCOUNT_ID=<set-in-your-.env>

# Stripe API
STRIPE_API_KEY=<set-in-your-.env>

# WhatsApp Business API (Meta Cloud API)
# WHATSAPP_TOKEN=your_whatsapp_cloud_api_token
# WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
# WHATSAPP_RECIPIENT_NUMBER=14155551234

# Postmortem reports: optional URL for Postmortem Writer screenshots (e.g. http://localhost:8000/dashboard/)
# POSTMORTEM_DASHBOARD_BASE_URL=

# App
WORKSPACE_PATH=./workspace
LOG_LEVEL=INFO
LOG_PATH=logs/aeco.log

# Company logging (structured workflow/agent/tool logs; one JSON line per event)
COMPANY_LOG_PATH=logs/company.log
COMPANY_LOG_CONSOLE=true
